<?xml version="1.0" encoding="utf-8"?>
<!--
    Responsive layout notes.
    Root vertical stack uses weightSum="1000" so every section's layout_weight
    is that section's percentage of the app content area times 10 (1 decimal precision).

    Top Gap            30   (3.0 percent)
    Scanning Card      304  (30.4 percent)
    Gap                29   (2.9 percent)
    Row 1 tiles        202  (20.2 percent)
    Gap                15   (1.5 percent)
    Row 2 tiles        202  (20.2 percent)
    Gap                12   (1.2 percent)
    Ask Nihal AI pill  67   (6.7 percent)
    Gap                40   (4.0 percent)
    Launch Button      69   (6.9 percent)
    Gap                30   (3.0 percent)
    Total              1000 (100 percent)

    Each tile row is a horizontal LinearLayout with weightSum="10000".
    Left Margin  415  (4.15 percent)
    Card 1       4430 (44.3 percent)
    Gap          310  (3.1 percent)
    Card 2       4430 (44.3 percent)
    Right Margin 415  (4.15 percent)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="1000"
    android:background="@color/onboarding_background">

    <!-- Top Gap : 3.0% (equal to bottom gap after Launch Button) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30" />

    <!-- Scanning Card : 30.4% -->
    <FrameLayout
        android:id="@+id/containerFirstPart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="304"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/boxFirstPart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_scan_card"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_shield_scan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="@string/scan_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/onboarding_heading"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textScanSubtitle"
                        android:text="@string/scan_subtitle_running"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/terminal_text_dim"
                        android:textSize="10.5sp" />

                </LinearLayout>

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:id="@+id/scrollTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_terminal"
                    android:padding="10dp"
                    android:scrollbars="none"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/textTerminalLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/terminal_text"
                        android:textSize="9.5sp"
                        android:lineSpacingExtra="2dp" />

                </ScrollView>

                <ScrollView
                    android:id="@+id/scrollResults"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/containerRiskResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </ScrollView>

                <LinearLayout
                    android:id="@+id/containerNoIssues"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/no_issues_icon_size"
                        android:layout_height="@dimen/no_issues_icon_size"
                        android:layout_marginBottom="4dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_shield_check" />

                    <TextView
                        android:text="@string/no_issues_found_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/onboarding_heading"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="13sp"
                        android:autoSizeStepGranularity="1sp" />

                    <TextView
                        android:text="@string/no_issues_found_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/terminal_text_dim"
                        android:gravity="center"
                        android:maxLines="2"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="7sp"
                        android:autoSizeMaxTextSize="10sp"
                        android:autoSizeStepGranularity="1sp" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Gap : 2.9% -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="29" />

    <!-- Row 1 tiles : 20.2% -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="202"
        android:orientation="horizontal"
        android:weightSum="10000">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="415" />

        <LinearLayout
            android:id="@+id/cardUninstallApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4430"
            android:orientation="vertical"
            android:background="@drawable/bg_feature_card"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_feature_icon_circle"
                android:padding="8dp"
                android:src="@drawable/ic_feature_uninstall" />

            <TextView
                android:text="@string/feature_uninstall_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/onboarding_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:text="@string/feature_uninstall_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/terminal_text_dim"
                android:textSize="10.5sp" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="310" />

        <LinearLayout
            android:id="@+id/cardOtpSms"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4430"
            android:orientation="vertical"
            android:background="@drawable/bg_feature_card"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_feature_icon_circle"
                android:padding="8dp"
                android:src="@drawable/ic_feature_otp_sms" />

            <TextView
                android:text="@string/feature_otp_sms_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/onboarding_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:text="@string/feature_otp_sms_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/terminal_text_dim"
                android:textSize="10.5sp" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="415" />

    </LinearLayout>

    <!-- Gap : 1.5% -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="15" />

    <!-- Row 2 tiles : 20.2% -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="202"
        android:orientation="horizontal"
        android:weightSum="10000">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="415" />

        <LinearLayout
            android:id="@+id/cardSocialScams"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4430"
            android:orientation="vertical"
            android:background="@drawable/bg_feature_card"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_feature_icon_circle"
                android:padding="8dp"
                android:src="@drawable/ic_feature_social_scams" />

            <TextView
                android:text="@string/feature_social_scams_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/onboarding_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:text="@string/feature_social_scams_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/terminal_text_dim"
                android:textSize="10.5sp" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="310" />

        <LinearLayout
            android:id="@+id/cardSeeMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4430"
            android:orientation="vertical"
            android:background="@drawable/bg_feature_card"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_feature_icon_circle"
                android:padding="8dp"
                android:src="@drawable/ic_feature_see_more" />

            <TextView
                android:text="@string/feature_see_more_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/onboarding_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:text="@string/feature_see_more_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/terminal_text_dim"
                android:textSize="10.5sp" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="415" />

    </LinearLayout>

    <!-- Gap : 1.2% -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="12" />

    <!-- Ask Nihal AI pill : 6.7% height. Width breakdown (horizontal weightSum="1000"):
         Screen Start to Capsule : 296 (29.6%)
         Capsule                 : 408 (40.8%)
         Capsule to Screen End   : 296 (29.6%) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="67"
        android:orientation="horizontal"
        android:weightSum="1000">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="296" />

        <LinearLayout
            android:id="@+id/containerAskNihalAi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="408"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_capsule_protected"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/imageAskNihalAiIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_sparkles" />

            <TextView
                android:id="@+id/textAskNihalAi"
                android:text="@string/ask_nihal_ai_label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/onboarding_accent"
                android:maxLines="1"
                android:includeFontPadding="false" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="296" />

    </LinearLayout>

    <!-- Gap : 4.0% -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="40" />

    <!-- Launch Button : 6.9% -->
    <Button
        android:id="@+id/buttonGo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="69"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@color/onboarding_accent"
        android:text="@string/action_go"
        android:textColor="@color/onboarding_button_text"
        android:textAllCaps="false"
        android:includeFontPadding="false"
        android:elevation="0dp" />

    <!-- Gap : 3.0% -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30" />

</LinearLayout>
