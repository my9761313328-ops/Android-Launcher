<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/onboarding_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/textAskExpertTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ask_expert_toolbar_title"
            android:textColor="@color/onboarding_heading"
            android:textStyle="bold"
            android:textSize="19sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/buttonNewChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_new_chat"
            android:textColor="@color/onboarding_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chat_new_chat_button"
            android:drawableStart="@drawable/ic_chat_new"
            android:drawablePadding="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:includeFontPadding="false"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <HorizontalScrollView
        android:id="@+id/scrollImagePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/containerImagePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chat_input_bar"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/buttonAttachImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chat_attach_button"
            android:src="@drawable/ic_chat_attach_image"
            android:scaleType="center"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/editChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:hint="@string/hint_ask_gemma"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/onboarding_heading"
            android:textSize="15sp"
            android:maxLines="4"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <ImageButton
            android:id="@+id/buttonSendMessage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chat_send_button"
            android:src="@drawable/ic_chat_send"
            android:scaleType="center"
            android:contentDescription="@null" />

    </LinearLayout>

</LinearLayout>
