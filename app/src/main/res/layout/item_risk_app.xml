<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_risk_row"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="6dp"
    android:weightSum="100">

    <!-- App Icon : 15% width, fills height, no fixed dp size -->
    <ImageView
        android:id="@+id/imageRiskAppIcon"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="15"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <!-- Gap : 5% -->
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5" />

    <!-- App Info : 80% width -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="80"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- App Name : auto-size, single line, fills height for max text size -->
        <TextView
            android:id="@+id/textRiskAppName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textColor="@color/onboarding_heading"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="500sp"
            android:autoSizeStepGranularity="1sp" />

    </LinearLayout>

</LinearLayout>
