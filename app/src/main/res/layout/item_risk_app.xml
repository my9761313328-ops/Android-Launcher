<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_risk_row"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="6dp"
    android:weightSum="100">

    <!-- App Icon : 15% width, fills height, no fixed dp size -->
    <ImageView
        android:id="@+id/imageRiskAppIcon"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="15"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <!-- App Info : 70% width -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="70"
        android:orientation="vertical">

        <!-- App Name : auto-size, single line -->
        <TextView
            android:id="@+id/textRiskAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/onboarding_heading"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="500sp"
            android:autoSizeStepGranularity="1sp" />

        <!-- Package Name : auto-size, single line -->
        <TextView
            android:id="@+id/textRiskAppPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/terminal_text_dim"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="500sp"
            android:autoSizeStepGranularity="1sp" />

    </LinearLayout>

    <!-- High Risk Badge : 15% width -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="15"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_high_risk_badge"
        android:paddingStart="8dp"
        android:paddingEnd="9dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:weightSum="100">

        <!-- Warning Icon : 30% of badge width, fills height -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="30"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_warning_small"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <!-- High Risk Text : 70% of badge width, auto-size -->
        <TextView
            android:text="@string/high_risk_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="70"
            android:textColor="@color/high_risk_text"
            android:textStyle="bold"
            android:maxLines="1"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="500sp"
            android:autoSizeStepGranularity="1sp" />

    </LinearLayout>

</LinearLayout>
