<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/onboarding_background">

    <TextView
        android:id="@+id/textSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:text="@string/choose_favourite_launcher_title"
        android:textColor="@color/onboarding_heading"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/launcherListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/onboarding_button_unselected" />

    <CheckBox
        android:id="@+id/checkboxDontAskAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:text="@string/dont_ask_me_again"
        android:textColor="@color/onboarding_heading" />

    <Button
        android:id="@+id/buttonLaunchIt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:background="@color/onboarding_accent"
        android:enabled="false"
        android:text="@string/action_launch_it"
        android:textColor="@color/onboarding_button_text"
        android:textAllCaps="false"
        android:elevation="0dp" />

</LinearLayout>
