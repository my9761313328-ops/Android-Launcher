<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="1000"
    android:background="@color/onboarding_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="663"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/imageGapFill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/premium_gap_image"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_premium_hero_glow"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:orientation="horizontal"
                android:weightSum="100">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="20" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textPremiumLabel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="60"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:text="@string/premium_label"
                    android:textColor="@color/onboarding_heading"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeMaxTextSize="96sp"
                    app:autoSizeStepGranularity="1sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="20" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/stepsStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginEnd="14dp"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_step_active">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_step_play"
                            android:importantForAccessibility="no" />

                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_step_dots" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textStepWatchTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/premium_step_watch_title"
                    android:textColor="@color/onboarding_heading"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textStepWatchSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/premium_step_watch_sub"
                    android:textColor="@color/premium_muted"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_step_dots" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_step_chevron"
                        android:importantForAccessibility="no" />

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_step_idle">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_step_unlock"
                            android:importantForAccessibility="no" />

                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_step_dots" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textStepUnlockTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/premium_step_unlock_title"
                    android:textColor="@color/onboarding_heading"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textStepUnlockSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/premium_step_unlock_sub"
                    android:textColor="@color/premium_muted"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_step_dots" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_step_chevron"
                        android:importantForAccessibility="no" />

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_step_idle">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_step_repeat"
                            android:importantForAccessibility="no" />

                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textStepRepeatTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/premium_step_repeat_title"
                    android:textColor="@color/onboarding_heading"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textStepRepeatSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/premium_step_repeat_sub"
                    android:textColor="@color/premium_muted"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="69"
        android:orientation="horizontal"
        android:weightSum="100">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="20" />

        <FrameLayout
            android:id="@+id/watchAdContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="60">

            <Button
                android:id="@+id/buttonWatchAd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/onboarding_accent"
                android:text="@string/action_watch_ad"
                android:textColor="@color/onboarding_button_text"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:elevation="0dp" />

            <TextView
                android:id="@+id/emojiWatchAd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:text="🎬"
                android:textSize="20sp"
                android:textColor="@color/onboarding_button_text"
                android:includeFontPadding="false"
                android:visibility="visible"
                android:clickable="false"
                android:focusable="false"
                android:elevation="4dp"
                android:translationZ="4dp"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="20" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="15" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="69"
        android:orientation="horizontal"
        android:weightSum="100"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="30" />

        <FrameLayout
            android:id="@+id/skipButtonContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="40"
            android:clipChildren="false"
            android:clipToPadding="false">

            <Button
                android:id="@+id/buttonSkip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/onboarding_button_unselected"
                android:text="@string/action_skip"
                android:textColor="@color/onboarding_heading"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:enabled="false"
                android:elevation="0dp" />

            <TextView
                android:id="@+id/skipCountdownBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-10dp"
                android:layout_marginEnd="-10dp"
                android:background="@drawable/bg_skip_countdown_badge"
                android:gravity="center"
                android:textColor="@color/onboarding_heading"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:elevation="6dp" />

        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="30" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="15" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="40" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="69"
        android:orientation="horizontal"
        android:weightSum="100">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="10" />

        <Button
            android:id="@+id/buttonLocked"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="80"
            android:background="@color/onboarding_accent"
            android:text="@string/action_locked"
            android:textColor="@color/onboarding_button_text"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:elevation="0dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="10" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30" />

</LinearLayout>
