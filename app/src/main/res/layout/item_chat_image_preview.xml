<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">

    <ImageView
        android:id="@+id/imagePreviewThumb"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_chat_image_thumb" />

    <ImageButton
        android:id="@+id/buttonRemovePreviewImage"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:padding="3dp"
        android:background="@drawable/bg_chat_remove_chip"
        android:src="@drawable/ic_chat_remove_image"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

</FrameLayout>
