<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/onboarding_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/textOtpSmsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/otp_sms_screen_title"
        android:textColor="@color/onboarding_heading"
        android:textStyle="bold"
        android:textSize="22sp"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/textOtpSmsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/otp_sms_screen_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerSmsApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/containerSmsNoApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/textSmsNoAppsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/otp_sms_no_apps_title"
            android:textColor="@color/onboarding_heading"
            android:textStyle="bold"
            android:textSize="18sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/textSmsNoAppsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/otp_sms_no_apps_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false" />

    </LinearLayout>

</LinearLayout>
