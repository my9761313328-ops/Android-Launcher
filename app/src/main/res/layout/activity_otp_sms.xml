<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/textOtpSmsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feature_otp_sms_title"
                android:textColor="@color/onboarding_heading"
                android:textStyle="bold"
                android:textSize="20sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/textOtpSmsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/otp_sms_scan_subtitle_running"
                android:textColor="@color/terminal_text_dim"
                android:textSize="13sp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="85">

            <ScrollView
                android:id="@+id/scrollSmsApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:id="@+id/containerSmsApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <LinearLayout
                android:id="@+id/containerSmsNoIssues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingStart="32dp"
                android:paddingEnd="32dp">

                <TextView
                    android:id="@+id/textSmsNoIssuesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_issues_found_title"
                    android:textColor="@color/safe_state_icon"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/textSmsNoIssuesSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/otp_sms_no_issues_subtitle"
                    android:textColor="@color/terminal_text_dim"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:includeFontPadding="false" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressSmsScan"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white"
                android:visibility="visible" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
