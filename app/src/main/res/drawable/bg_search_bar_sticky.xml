<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Matches the core app capsule styling: same border color, and a
         solid fill using the launcher's screen background color (instead of
         truly transparent) so that when pinned to the top, the scrolling
         app list doesn't show through the bar. -->
    <solid android:color="@color/screen_background" />
    <stroke android:width="1.4dp" android:color="@color/core_app_border" />
    <corners android:radius="25dp" />
</shape>
