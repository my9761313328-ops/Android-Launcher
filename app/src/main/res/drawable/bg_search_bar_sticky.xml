<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Matches the core app capsule styling exactly: transparent fill,
         core_app_border stroke. Used for both the inline and pinned search
         bar shells so the bar always looks the same, pinned or not. -->
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1.4dp" android:color="@color/core_app_border" />
    <corners android:radius="25dp" />
</shape>
